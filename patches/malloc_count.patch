 #include "malloc_count.h"
 
 /* user-defined options for output malloc()/free() operations to stderr */
 
 static const int log_operations = 0;    /* <-- set this to 1 for log output */
-static const size_t log_operations_threshold = 1024*1024;
+static const size_t log_operations_threshold = 1024*1024*2;
 
 /* option to use gcc's intrinsics to do thread-safe statistics operations */
-#define THREAD_SAFE_GCC_INTRINSICS      0
+#define THREAD_SAFE_GCC_INTRINSICS      1
 
 /* to each allocation additional data is added for bookkeeping. due to
  * alignment requirements, we can optionally add more than just one integer.
@@ -64,6 +66,10 @@ static aligned_alloc_type real_aligned_alloc = NULL;
 static free_type real_free = NULL;
 static realloc_type real_realloc = NULL;
 
+static void init(void);
+
+static int mc_initializing = 0;
+
 /* a sentinel value prefixed to each allocation */
 static const size_t sentinel = 0xDEADC0DE;
 
@@ -85,61 +91,108 @@ static long long peak = 0, curr = 0, total = 0, num_allocs = 0;
 static malloc_count_callback_type callback = NULL;
 static void* callback_cookie = NULL;
 
-/* add allocation to statistics */
-static void inc_count(size_t inc)
+/* the allocations and frees of a thread are added to the statistics in batches: once the net sum of their sizes since
+ * the last batch reaches batch_bytes in absolute value (at once for an allocation of at least batch_bytes), when the
+ * thread reads the statistics and when it exits; curr and peak then lie at most batch_bytes per thread below or above
+ * their exact values, and an allocation that is freed soon by the same thread does not touch the shared counters */
+static const long long batch_bytes = 4096;
+static __thread long long batch_curr = 0, batch_total = 0, batch_allocs = 0;
+/* whether the thread exit of the thread adds its batch (see flush_at_exit) */
+static __thread int batch_registered = 0;
+static pthread_key_t batch_key;
+static int batch_key_created = 0;
+
+/* adds the batch of the calling thread to the statistics */
+static void flush_batch(void)
 {
 #if THREAD_SAFE_GCC_INTRINSICS
-    long long mycurr = __sync_add_and_fetch(&curr, inc);
-    if (mycurr > peak) peak = mycurr;
-    total += inc;
-    if (callback) callback(callback_cookie, mycurr);
+    long long mycurr = __sync_add_and_fetch(&curr, batch_curr);
+
+    /* set peak to the maximum of peak and mycurr */
+    if (batch_curr > 0) {
+        long long seen = peak;
+        while (mycurr > seen && !__sync_bool_compare_and_swap(&peak, seen, mycurr)) seen = peak;
+    }
+
+    if (batch_total != 0) __sync_add_and_fetch(&total, batch_total);
+    if (batch_allocs != 0) __sync_add_and_fetch(&num_allocs, batch_allocs);
 #else
-    if ((curr += inc) > peak) peak = curr;
-    total += inc;
-    if (callback) callback(callback_cookie, curr);
+    long long mycurr = (curr += batch_curr);
+    if (curr > peak) peak = curr;
+    total += batch_total;
+    num_allocs += batch_allocs;
 #endif
-    ++num_allocs;
+    batch_curr = batch_total = batch_allocs = 0;
+    if (callback) callback(callback_cookie, mycurr);
+}
+
+/* the destructor of batch_key: adds the batch of an exiting thread */
+static void flush_at_exit(void* unused)
+{
+    (void) unused;
+    flush_batch();
+    batch_registered = 0;
+}
+
+/* adds a change of the allocated memory to the batch of the calling thread */
+static void add_to_batch(long long delta)
+{
+    if (!batch_registered && batch_key_created) {
+        batch_registered = 1;
+        /* a value other than NULL, so that the thread exit calls flush_at_exit */
+        pthread_setspecific(batch_key, &batch_registered);
+    }
+
+    batch_curr += delta;
+    if (batch_curr >= batch_bytes || batch_curr <= -batch_bytes) flush_batch();
+}
+
+/* add allocation to statistics */
+static void inc_count(size_t inc)
+{
+    batch_total += (long long) inc;
+    batch_allocs++;
+    add_to_batch((long long) inc);
 }
 
 /* decrement allocation to statistics */
 static void dec_count(size_t dec)
 {
-#if THREAD_SAFE_GCC_INTRINSICS
-    long long mycurr = __sync_sub_and_fetch(&curr, dec);
-    if (callback) callback(callback_cookie, mycurr);
-#else
-    curr -= dec;
-    if (callback) callback(callback_cookie, curr);
-#endif
+    add_to_batch(-(long long) dec);
 }
 
 /* user function to return the currently allocated amount of memory */
 extern size_t malloc_count_current(void)
 {
+    flush_batch();
     return curr;
 }
 
 /* user function to return the peak allocation */
 extern size_t malloc_count_peak(void)
 {
+    flush_batch();
     return peak;
 }
 
 /* user function to reset the peak allocation to current */
 extern void malloc_count_reset_peak(void)
 {
+    flush_batch();
     peak = curr;
 }
 
 /* user function to return total number of allocations */
 extern size_t malloc_count_num_allocs(void)
 {
+    flush_batch();
     return num_allocs;
 }
 
 /* user function which prints current and peak allocation to stderr */
 extern void malloc_count_print_status(void)
 {
+    flush_batch();
     fprintf(stderr, PPREFIX "current %'lld, peak %'lld\n",
             curr, peak);
 }
@@ -162,11 +215,23 @@ extern void* malloc(size_t size)
 
     if (size == 0) return NULL;
 
+    if (!real_malloc && !mc_initializing) {
+        mc_initializing = 1;
+        init();
+        mc_initializing = 0;
+    }
+
     if (real_malloc)
