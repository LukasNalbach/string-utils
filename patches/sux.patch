diff --git a/sux/util/ParallelBuild.hpp b/sux/util/ParallelBuild.hpp
new file mode 100644
index 0000000..25174d9
--- /dev/null
+++ b/sux/util/ParallelBuild.hpp
@@ -0,0 +1,154 @@
+/*
+ * Sux: Succinct data structures
+ *
+ * Parallel construction of the two-level inventories of the select structures in sux/bits. If complement
+ * is true, the inventories are built for the zeros of the bit vector (each word is complemented).
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#ifdef _OPENMP
+#include <omp.h>
+#endif
+
+namespace sux::util {
+
+/** Returns the i-th word of the bit vector (complemented, if complement is true). */
+template <bool complement> static inline uint64_t build_word(const uint64_t *const bits, const uint64_t i) {
+	return complement ? ~bits[i] : bits[i];
+}
+
+/** Returns the i-th word of the bit vector (see build_word) with the bits at the positions >= num_bits
+ *  cleared; returns 0 without reading the word, if it starts at a position >= num_bits. */
+template <bool complement> static inline uint64_t build_masked_word(const uint64_t *const bits, const uint64_t i, const uint64_t num_bits) {
+	const uint64_t base = i * 64;
+	if (base >= num_bits) return 0;
+	const uint64_t word = build_word<complement>(bits, i);
+	if (base + 64 <= num_bits) return word;
+	return word & ((UINT64_C(1) << (num_bits - base)) - 1);
+}
+
+/** Advances i to the next word that contains a one and returns that word (see build_masked_word);
+ *  returns 0, if there is no such word. */
+template <bool complement> static inline uint64_t build_next_word(const uint64_t *const bits, uint64_t &i, const uint64_t num_bits) {
+	uint64_t word = 0;
+	while (word == 0 && (++i) * 64 < num_bits) word = build_masked_word<complement>(bits, i, num_bits);
+	return word;
+}
+
+/** Splits the bit vector into chunks of words and counts the ones before each chunk.
+ *
+ * @param bits a bit vector of 64-bit words.
+ * @param num_words the length (in 64-bit words) of the bit vector.
+ * @param threads the number of threads to use.
+ * @param first_word output: chunk t consists of the words [first_word[t], first_word[t + 1]).
+ * @param ones_before output: ones_before[t] is the number of ones in the words before chunk t;
+ * ones_before[chunks] is the number of ones in all words (including the bits of the last word at the
+ * positions >= num_bits).
+ * @return the number of chunks.
+ */
+template <bool complement>
+static inline uint64_t build_count_by_chunk(const uint64_t *const bits, const uint64_t num_words, const uint64_t threads,
+										   std::vector<uint64_t> &first_word, std::vector<uint64_t> &ones_before) {
+	const uint64_t chunks = threads <= 1 ? 1 : threads * 4;
+
+	first_word.resize(chunks + 1);
+	ones_before.resize(chunks + 1);
+	for (uint64_t t = 0; t <= chunks; t++) first_word[t] = (t * num_words) / chunks;
+
+#pragma omp parallel for num_threads(threads) schedule(static)
+	for (uint64_t t = 0; t < chunks; t++) {
+		uint64_t count = 0;
+		for (uint64_t i = first_word[t]; i < first_word[t + 1]; i++) count += __builtin_popcountll(build_word<complement>(bits, i));
+		ones_before[t + 1] = count;
+	}
+
+	ones_before[0] = 0;
+	for (uint64_t t = 0; t < chunks; t++) ones_before[t + 1] += ones_before[t];
+	return chunks;
+}
+
+/** Writes the position of every 2^log2_per_inventory-th one into the first level of the inventory.
+ *
+ * @param count the number of ones at the positions < num_bits.
+ * @param log2_per_inventory the base-2 logarithm of the number of ones per inventory.
+ * @param longwords_per_inventory the number of 64-bit words per inventory (first-level entry and subinventory).
+ * @param first_word, ones_before, chunks the chunks (see build_count_by_chunk).
+ */
+template <bool complement>
+static inline void build_first_level(const uint64_t *const bits, const uint64_t num_bits, const uint64_t num_words, const uint64_t count,
+									 const int log2_per_inventory, const int longwords_per_inventory, int64_t *const inventory,
+									 const std::vector<uint64_t> &first_word, const std::vector<uint64_t> &ones_before, const uint64_t chunks,
+									 const uint64_t threads) {
+	const uint64_t mask = (UINT64_C(1) << log2_per_inventory) - 1;
+
+#pragma omp parallel for num_threads(threads) schedule(static)
+	for (uint64_t t = 0; t < chunks; t++) {
+		uint64_t d = ones_before[t];
+
+		for (uint64_t i = first_word[t]; i < first_word[t + 1] && d < count; i++) {
+			uint64_t word = build_masked_word<complement>(bits, i, num_bits);
+
+			while (word != 0 && d < count) {
+				if ((d & mask) == 0) inventory[(d >> log2_per_inventory) * longwords_per_inventory] = i * 64 + __builtin_ctzll(word);
+				d++;
+				word &= word - 1;
+			}
+		}
+	}
+}
+
+/** Writes the subinventory of each inventory (used by SimpleSelectHalf and SimpleSelectZeroHalf): the
+ *  offsets of every 2^log2_per_sub16-th one (16-bit entries) or of every 2^log2_per_sub64-th one (64-bit
+ *  entries) from the first one of the inventory. The first-level entry of each inventory with a span
+ *  larger than 2^16 is negated. The parameters are those of build_first_level.
+ */
+template <bool complement>
+static inline void build_second_level(const uint64_t *const bits, const uint64_t num_bits, const uint64_t count, const uint64_t inventory_size,
+									  const int log2_per_inventory, const int log2_per_sub16, const int log2_per_sub64,
+									  const int longwords_per_inventory, int64_t *const inventory, const uint64_t threads) {
+	const uint64_t per_inventory = UINT64_C(1) << log2_per_inventory;
+	// negate[k] = 1 <=> the first-level entry of inventory k has to be negated; the entries are negated
+	// after all spans have been computed (the span of inventory k is computed from the entry of inventory k + 1)
+	std::vector<char> negate(inventory_size, 0);
+
+#pragma omp parallel for num_threads(threads) schedule(static)
+	for (uint64_t k = 0; k < inventory_size; k++) {
+		const uint64_t start = uint64_t(inventory[k * longwords_per_inventory]);
+		const uint64_t span = uint64_t(inventory[(k + 1) * longwords_per_inventory]) - start;
+		if (span > (1 << 16)) negate[k] = 1;
+
+		int64_t *const p64 = &inventory[k * longwords_per_inventory + 1];
+		uint16_t *const p16 = (uint16_t *)p64;
+		const uint64_t d_beg = k * per_inventory;
+		const uint64_t d_end = count < d_beg + per_inventory ? count : d_beg + per_inventory;
+
+		uint64_t i = start / 64;
+		uint64_t word = build_masked_word<complement>(bits, i, num_bits) & (~UINT64_C(0) << (start % 64));
+
+		for (uint64_t d = d_beg; d < d_end; d++) {
+			if (word == 0) word = build_next_word<complement>(bits, i, num_bits);
+			if (word == 0) break;
+
+			const uint64_t at = i * 64 + __builtin_ctzll(word);
+
+			if (span < (1 << 16)) {
+				if ((d & ((UINT64_C(1) << log2_per_sub16) - 1)) == 0) p16[(d - d_beg) >> log2_per_sub16] = at - start;
+			} else {
+				if ((d & ((UINT64_C(1) << log2_per_sub64) - 1)) == 0) p64[(d - d_beg) >> log2_per_sub64] = at - start;
+			}
+
+			word &= word - 1;
+		}
+	}
+
+#pragma omp parallel for num_threads(threads) schedule(static)
+	for (uint64_t k = 0; k < inventory_size; k++) {
+		if (negate[k]) inventory[k * longwords_per_inventory] = -inventory[k * longwords_per_inventory] - 1;
+	}
+}
+
+} // namespace sux::util
